# ===== System & tool artifacts =====
.DS_Store
__pycache__/
*.pyc
.codex/
/tmp/
logs/command-log.jsonl

# ===== Large audio/video files not tracked =====
# To commit a specific file anyway, add it explicitly with: git add -f
*.m4a
*.mp3
*.wav
*.mp4
*.mov

# ===== Local-only working area: never tracked =====
# Put API tokens and other machine-only files here.
/local/

# ===== Secrets / credentials: never tracked, anywhere =====
.env
.env.*
*_token.txt
*.token

# Portfolio report is kept local, not published
reports/portfolio-latest.md
